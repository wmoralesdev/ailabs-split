  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
