// Split — trip cost rooms, members, expenses (integer cents only)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id                   String              @id @default(cuid())
  code                 String              @unique
  name                 String
  // TRIP (default), DINNER, or HOUSEHOLD — dinner is a one-time bill; household is the house.
  kind                 String              @default("TRIP")
  // Base/settlement currency for the room (e.g. the members' home currency).
  currency             String
  // Allowed currencies for expenses (includes the base currency).
  currencies           String[]            @default([])
  // Exchange rates as units of the currency per 1 base currency, e.g. { "CRC": 505 }.
  fxRates              Json?
  // Bank FX markup in basis points from multi-sample calibration (87 = +0.87%).
  fxAdjustmentBps      Int                 @default(0)
  // Calibration samples: [{ appCents, bankCents, expenseId? }].
  fxCalibrationSamples Json?
  // Clerk user id of whoever created the room (null for anonymous creates).
  // HOUSEHOLD: required by the server, not by this column.
  ownerUserId          String?
  createdAt            DateTime            @default(now())
  members              Member[]
  expenses             Expense[]
  settlements          Settlement[]
  checks               Check[]
  hides                RoomHide[]
  templates            RecurringTemplate[]

  @@index([ownerUserId])
}

// A signed-in person's own account number, shown wherever they get paid.
model PayProfile {
  userId    String   @id
  account   String
  label     String?
  updatedAt DateTime @updatedAt
}

model RoomHide {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

model Member {
  id                         String              @id @default(cuid())
  roomId                     String
  name                       String
  // Clerk user id of the housemate who claimed this seat. HOUSEHOLD only.
  userId                     String?
  // HOUSEHOLD: guest (not in charges or templates by default). Trips/bills: always false.
  isGuest                    Boolean             @default(false)
  // HOUSEHOLD: move-in / move-out dates (day, no time).
  joinedOn                   DateTime?           @db.Date
  leftOn                     DateTime?           @db.Date
  // Typed by people in the room for someone added by name. A seat with a userId
  // reads PayProfile instead. Never filled from receipt OCR.
  payAccount                 String?
  payLabel                   String?
  createdAt                  DateTime            @default(now())
  room                       Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  paidExpenses               Expense[]           @relation("ExpensePaidBy")
  paidChecks                 Check[]             @relation("CheckPaidBy")
  shares                     ExpenseShare[]
  settlementPaymentsSent     Settlement[]        @relation("SettlementFrom")
  settlementPaymentsReceived Settlement[]        @relation("SettlementTo")
  createdExpenses            Expense[]           @relation("ExpenseCreatedBy")
  createdSettlements         Settlement[]        @relation("SettlementCreatedBy")
  templatesPaid              RecurringTemplate[] @relation("TemplatePaidBy")
  templateShares             RecurringShare[]

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Expense {
  id                String               @id @default(cuid())
  roomId            String
  title             String
  amountCents       Int
  category          String?
  // Currency this expense was recorded in; null falls back to the room base currency.
  currency          String?
  // How shares were derived: EQUAL | PARTS | AMOUNT.
  splitMode         String               @default("EQUAL")
  // Personal expenses are only visible to the payer and do not affect group settle.
  isPersonal        Boolean              @default(false)
  paidById          String
  createdAt         DateTime             @default(now())
  // Manual display order (lower first). New expenses get min(sortIndex)-1 so
  // they appear at the top. Ties fall back to createdAt desc.
  sortIndex         Int                  @default(0)
  // HOUSEHOLD: month the charge covers, "YYYY-MM" (Oct power paid in Nov → "2026-10").
  periodMonth       String?
  // HOUSEHOLD: day the charge was paid.
  paidOn            DateTime?            @db.Date
  // Author (edit/delete permission). Null on older trips/bills.
  createdByMemberId String?
  // HOUSEHOLD 1B: receipt photo on the charge. Not OCR text. Null on trips/bills.
  receiptBytes      Bytes?
  receiptMimeType   String?
  room              Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  paidBy            Member               @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy         Member?              @relation("ExpenseCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  shares            ExpenseShare[]
  check             Check?
  occurrence        RecurringOccurrence?

  @@index([roomId])
  @@index([paidById])
  @@index([roomId, sortIndex])
  @@index([roomId, periodMonth])
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String
  memberId    String
  amountCents Int
  // Relative weight when the expense uses PARTS split mode (null otherwise).
  weight      Int?
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member      Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([memberId])
}

model Check {
  id          String   @id @default(cuid())
  roomId      String
  expenseId   String?  @unique
  merchant    String
  currency    String
  paidById    String
  status      String   @default("DRAFT")
  isPrecuenta Boolean  @default(false)
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  paidBy      Member   @relation("CheckPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([paidById])
}

model Settlement {
  id                String   @id @default(cuid())
  roomId            String
  fromMemberId      String
  toMemberId        String
  amountCents       Int
  currency          String
  createdAt         DateTime @default(now())
  // Optional transfer screenshot. Never required to settle. Omitted from room
  // list queries; fetched by settlement id when someone opens the photo.
  proofBytes        Bytes?
  proofMimeType     String?
  // Who recorded it (may delete it, or the recipient may).
  createdByMemberId String?
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromMember        Member   @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember          Member   @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  createdBy         Member?  @relation("SettlementCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model RecurringTemplate {
  id                String                @id @default(cuid())
  roomId            String
  title             String
  category          String
  // FIXED: known amount. VARIABLE: amount empty until the month is confirmed.
  kind              String
  amountCents       Int?
  dueDay            Int
  paidById          String
  splitMode         String                @default("EQUAL")
  startMonth        String
  archivedAt        DateTime?
  createdByMemberId String?
  createdAt         DateTime              @default(now())
  room              Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  paidBy            Member                @relation("TemplatePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  shares            RecurringShare[]
  occurrences       RecurringOccurrence[]

  @@index([roomId])
}

model RecurringShare {
  id          String            @id @default(cuid())
  templateId  String
  memberId    String
  weight      Int?
  amountCents Int?
  template    RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([templateId, memberId])
}

// A month already handled for a template: confirmed (with its Expense) or skipped.
model RecurringOccurrence {
  id                String            @id @default(cuid())
  templateId        String
  periodMonth       String
  status            String
  expenseId         String?           @unique
  createdByMemberId String?
  createdAt         DateTime          @default(now())
  template          RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  expense           Expense?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([templateId, periodMonth])
}
